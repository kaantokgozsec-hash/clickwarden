# ---------------------------------------------------------------------------
# Optional non-secret Clickwarden settings. Copy to .env (git-ignored) if you want them.
# Provider, model, API key and data-sharing consent are set with:  clickwarden configure
# Never put an API key in this file or commit it.
# ---------------------------------------------------------------------------

# CLICKWARDEN_JPEG_QUALITY=85
# CLICKWARDEN_TURBO_WIDTH=1280
# CLICKWARDEN_ROI_MAX_WIDTH=1600
# CLICKWARDEN_HUD=1              # 0 disables the on-screen overlay
# CLICKWARDEN_THINKING=0         # 1 keeps model reasoning (slower, more tokens)
# CLICKWARDEN_LOCATE_MAX_TOKENS=160
# CLICKWARDEN_PRICE_IN=0         # USD per 1M prompt tokens (cost estimates)
# CLICKWARDEN_PRICE_OUT=0        # USD per 1M completion tokens
# CLICKWARDEN_TEXT_ONLY=1        # omit the screenshot-export MCP tool (default)
# CLICKWARDEN_JOB_DIR=C:/Users/you/.clickwarden/jobs
# CLICKWARDEN_CONFIG_DIR=        # default: %APPDATA%\clickwarden

# Advanced / headless use (set by the human operator, never by an AI agent):
# CLICKWARDEN_API_KEY=           # overrides the encrypted stored key
# CLICKWARDEN_API_URL=
# CLICKWARDEN_VISION_MODEL=
# CLICKWARDEN_COORD_SPACE=pixels # or norm1000 for models answering on a 0-1000 grid
# CLICKWARDEN_SEND_THINKING_DISABLED=0
# CLICKWARDEN_EXTRA_HEADERS={}   # JSON object of provider-documented headers
# CLICKWARDEN_ACCEPT_DATA_FLOW=  # your host name, e.g. api.example.com, confirms YOU accept sending screens there
